{
  "name": "lode-graph",
  "version": "0.3.1",
  "description": "Read a codebase as a flow of real code: a code graph, embeddable views any editor or app can host, git changes, and questions answered as flows.",
  "keywords": [
    "code-graph",
    "code-reading",
    "code-navigation",
    "call-graph",
    "static-analysis",
    "typescript",
    "ruby",
    "rails",
    "python",
    "mcp",
    "llm-context",
    "web-components",
    "tree-sitter"
  ],
  "homepage": "https://github.com/damiensmith1/lode-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiensmith1/lode-graph.git"
  },
  "bugs": {
    "url": "https://github.com/damiensmith1/lode-graph/issues"
  },
  "author": "Damien Smith",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lode": "dist/lib/src/cli.js"
  },
  "types": "./dist/lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/src/index.d.ts",
      "import": "./dist/lib/src/index.js"
    },
    "./server": {
      "types": "./dist/lib/src/server/index.d.ts",
      "import": "./dist/lib/src/server/index.js"
    },
    "./mcp": {
      "types": "./dist/lib/src/mcp/index.d.ts",
      "import": "./dist/lib/src/mcp/index.js"
    },
    "./views": {
      "types": "./dist/lib/views/index.d.ts",
      "import": "./dist/lib/views/index.js"
    },
    "./views/bundle": "./dist/views/lode-views.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "dist/views",
    "README.md",
    "docs/embedding.md",
    "skills",
    "!dist/**/*.map"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lode": "tsx src/cli.ts",
    "build:web": "tsx hosts/app/build.ts",
    "build": "tsx scripts/build.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "stemmer": "2.0.1",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
