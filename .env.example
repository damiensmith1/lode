# lode's settings. Copy to .env (git-ignored) in lode's folder and fill in
# what you use. lode reads only these settings, and only from its own
# folder's .env, never a project's. Everything is optional: without keys,
# reading, changes, editing and context still work.

# --- "/" questions: flows built for a question (TypeSafe's Jev) ------------
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# --- Explain: a conversation about the canvas ----------------------------
# Every provider with a key is offered; you pick the model per question in
# the panel (grouped by provider). Models are listed as id=Label, comma
# separated (ids may contain "/" and ":", as OpenRouter's do).

# Anthropic (Claude). Default models: Sonnet, Haiku, Opus.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# LODE_ANTHROPIC_MODELS=claude-sonnet-5-5=Sonnet,claude-haiku-5-5=Haiku,claude-opus-5-5=Opus

# OpenAI, or any OpenAI-compatible server (set OPENAI_BASE_URL: Groq,
# Together, Ollama, LM Studio, vLLM…). List the models to offer.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# LODE_OPENAI_MODELS=model-id=Label,other-model-id=Other

# OpenRouter. List the models to offer (ids from openrouter.ai/models).
OPENROUTER_API_KEY=
# LODE_OPENROUTER_MODELS=anthropic/claude-sonnet-4.5=Claude Sonnet,openai/gpt-4o=GPT-4o

# The model a question gets before you pick one, as provider:model
# (default: the first provider's first model).
# LODE_EXPLAIN_MODEL=anthropic:claude-sonnet-5-5
